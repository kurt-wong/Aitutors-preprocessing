# ============================================================
# Aitutors-preprocessing .gitignore
# 原则:代码+文档+小体积审计数据进库;原始大数据/敏感/产物排除
# ============================================================

# --- 大体量原始数据(数百 MB~百 GB 级)---
/original/
/maintainess/
/_archive/
/Ocr-markdown/
/reports/

# --- 敏感配置(API key 等,绝不入库)---
/data/.llm_config
*llm_config*

# --- 运行时产物 ---
/logs/reslice_debug/
/data/_p2adv_tmp/
__pycache__/
*.pyc
*.tmp
.pytest_tmp/
.pytest_work/
pytest-cache-files-*/

# --- 测试样本(显式保留,供代码审查对照数据结构)---
!/tests/

# --- 历史遗留大文件/陈旧提示词(R54 时代有意不入库,f8a6d09 误扫后恢复;sha256 见 f1_summary/resolver_report)---
/RS.MD
/data/r54_f1/f1_report.json
/data/resolver_ref_r52/resolver_ir.json
/logs/reslice_reslice-pac-annotated_log.txt
/logs/ocr_child_err.log

# --- P2.2 最小修复轮中间过程产物(混版/重跑实验,非收口证据;收口证据=data/p2_2_b2_measure.json)---
/data/p2_2_fix_measure.json
/data/p2_2_fix_batch2.json
/data/reslice_reslice-p2-2-fix_result.json
/data/reslice_reslice-p2-2-fix_summary.json
/data/reslice_reslice-p2-2-fix2_result.json
/data/reslice_reslice-p2-2-fix2_summary.json
/data/reslice_reslice-p2-b2-rerun_result.json
/data/reslice_reslice-p2-b2-rerun_summary.json
/logs/reslice_reslice-p2-2-fix_log.txt
/logs/reslice_reslice-p2-2-fix2_log.txt
/logs/reslice_reslice-p2-b2-rerun_log.txt
